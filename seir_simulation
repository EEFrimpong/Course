                method=solver
            )
            print(f"  ✓ Success!")
            print(f"  Final S: {x_sim['S'][-1]:,.0f}")
            print(f"  Final E: {x_sim['E'][-1]:,.0f}")
            print(f"  Final I: {x_sim['I'][-1]:,.0f}")
